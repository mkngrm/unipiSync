#### Unifi Controller Configuration #######
UNIFI_HOST=192.168.1.1
UNIFI_PORT=443
UNIFI_API_TOKEN=your-api-token-here
UNIFI_SITE=your-unifi-site-name-here

#### Pi-hole Configuration #######
PIHOLE_HOST=192.168.1.2
PIHOLE_PASSWORD=your-pihole-password-here

#### DNS Configuration #######
DNS_DOMAIN=example.com

#### Network Configuration
# ALLOWED_SUBNETS: Comma-separated list of subnet prefixes to sync (uses IP prefix matching)
#   - Leave empty or comment out to sync ALL DHCP leases
#   - Single subnet: ALLOWED_SUBNETS=192.168.70.
#   - Multiple subnets: ALLOWED_SUBNETS=192.168.10.,192.168.20.
#   - Entire private network: ALLOWED_SUBNETS=192.168.
ALLOWED_SUBNETS=192.168.70.

# EXCLUDED_SUBNETS: Comma-separated list of subnet prefixes to exclude (takes precedence over ALLOWED_SUBNETS)
#   - Leave empty or comment out to exclude nothing
#   - Example: EXCLUDED_SUBNETS=192.168.1.,192.168.2.
#   - Useful for excluding management networks, guest networks, etc.
EXCLUDED_SUBNETS=

#### Logging
LOG_FILE=/var/log/unipiSync.log
LOG_LEVEL=INFO

#### State Management
# STATE_FILE: Tracks which DNS records are managed by unipiSync (vs manual records)
#   - unipiSync will only delete records it has created
#   - Manual DNS records in Pi-hole will never be touched
STATE_FILE=/var/lib/unipiSync/state.json

#### Notifications (optional)
# NTFY_ENABLED: Enable/disable ntfy notifications (true/false, default: false)
NTFY_ENABLED=false

# NTFY_HOST: ntfy server URL (required if NTFY_ENABLED=true)
#   - Self-hosted: http://192.168.1.100:8080 or https://ntfy.yourdomain.com
#   - Public service: https://ntfy.sh
NTFY_HOST=https://ntfy.sh

# NTFY_TOPIC: Topic name for notifications (required if NTFY_ENABLED=true)
#   - Example: unipisync-alerts, homelab-dns, etc.
NTFY_TOPIC=unipisync

# NTFY_TOKEN: Authentication token (optional, only needed for protected topics)
#   - Generate in ntfy web UI or via ntfy CLI
#   - Leave empty for public topics
NTFY_TOKEN=

# NTFY_PRIORITY: Notification priority (default: default)
#   - Options: min, low, default, high, urgent
NTFY_PRIORITY=default
